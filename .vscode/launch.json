{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Python：运行当前文件",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "python": "${workspaceFolder}/.venv/bin/python",
      "cwd": "${workspaceFolder}",
      "console": "internalConsole",
      "internalConsoleOptions": "openOnSessionStart",
      "redirectOutput": true,
      "justMyCode": true
    }
  ]
}
